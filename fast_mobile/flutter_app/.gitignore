.pub-cache/
.pub/
/build/
/coverage/

# Android uygulama kaynaklari (ikon/mipmap/drawable) git'e dahil edilsin
!android/app/src/main/res/**

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
