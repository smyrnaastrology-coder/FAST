# Fast Koç — ortam değişkenleri (örnek; gerçek değerleri Render paneline girin)
# Veritabanı (üretimde Postgres; boşsa SQLite)
FASTKOC_DATABASE_URL=
# Dönem bayrağı: 2026-27'de false; 2027-28'de true (tümü Maarif)
FASTKOC_TUMU_MAARIF=false
# Auth (üretimde true + Supabase JWT secret zorunlu)
AUTH_ZORUNLU=false
SUPABASE_JWT_SECRET=
FASTKOC_DEV_TOKEN=
# Admin panel şifresi
FASTKOC_ADMIN_SIFRE=fastkoc-admin
# Push (Firebase Cloud Messaging server key)
FCM_SERVER_KEY=
# Ödeme (Stripe; boşsa stub link)
STRIPE_SECRET_KEY=
ODEME_ZORUNLU=false
# Yapay zekâ koç yorumu (boşsa şablon yorum)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Veli SMS (Netgsm; boşsa kuyruğa yazılır)
SMS_API_ANAHTARI=
